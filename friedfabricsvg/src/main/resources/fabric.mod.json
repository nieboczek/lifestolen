{
    "schemaVersion": 1,
    "id": "friedfabricsvg",
    "version": "${version}",
    "name": "Fried Fabric SVG",
    "description": "SVG rendering utilities for Fabric mods",
    "environment": "client",
    "entrypoints": {
        "client": [{
            "adapter": "kotlin",
            "value": "nieboczek.friedfabricsvg.FriedFabricSvg"
        }]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": ">=${minecraft_version}",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=1.13.12"
    }
}
