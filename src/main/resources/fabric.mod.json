{
  "schemaVersion": 1,
  "id": "lifestolen",
  "version": "${version}",
  "name": "Lifestolen",
  "description": "Minecraft utility mod",
  "authors": [
    "nieboczek"
  ],
  "contact": {
    "sources": "https://github.com/nieboczek/lifestolen"
  },
  "license": "GPL-3.0",
  "icon": "assets/lifestolen/icon.png",
  "accessWidener": "lifestolen.accesswidener",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "nieboczek.lifestolen.Lifestolen"
      }
    ]
  },
  "mixins": [
    "lifestolen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
